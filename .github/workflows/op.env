# 1Password secret references for mctl config CI.
# Copy this file to .github/workflows/op.env in the CMC repo.
#
# Vault: "mctl - common" — a dedicated vault for the mctl service account.
# OP_VAULT is set at the workflow level (config.yaml env block), not here.
#
# Each credential group lives in its own vault item so access can be
# granted and rotated independently. Create these items in the vault
# before running mctl config in CI:
#
#   mctl-common    — Grafana, Sentry, GSOCI ACR pull credentials, GitHub App (all providers)
#   mctl-azure     — CAPZ bootstrap service principal (makes Azure SDK calls)
#   mctl-azure-dns — Azure DNS operator SP; defaults to bootstrap SP if absent
#   mctl-aws       — AWS bootstrap IAM credentials (makes AWS SDK calls)
#   mctl-route53   — Route53 DNS operator credentials (CAPV, CAPVCD)
#   mctl-vsphere   — CAPV vSphere credentials
#   mctl-vcd       — CAPVCD VCD refresh token

# ── Required — all providers ──────────────────────────────────────────────────

GRAFANA_CLOUD_API_KEY=op://mctl - common/mctl-common/GRAFANA_CLOUD_API_KEY
GRAFANA_CLOUD_USERNAME=op://mctl - common/mctl-common/GRAFANA_CLOUD_USERNAME
SENTRY_TOKEN=op://mctl - common/mctl-common/SENTRY_TOKEN
GSOCI_ACR_USERNAME=op://mctl - common/mctl-common/GSOCI_ACR_USERNAME
GSOCI_ACR_PASSWORD=op://mctl - common/mctl-common/GSOCI_ACR_PASSWORD
# silence-operator: use static PAT (preferred for CI) or GitHub App if available
SILENCE_OPERATOR_GITHUB_TOKEN=op://mctl - common/mctl-common/SILENCE_OPERATOR_GITHUB_TOKEN

# ── Optional — all providers ──────────────────────────────────────────────────
# Uncomment if populated in the vault:
# EVENT_EXPORTER_SLACK_WEBHOOK=op://mctl - common/mctl-common/EVENT_EXPORTER_SLACK_WEBHOOK
# CRONITOR_MANAGEMENT_KEY=op://mctl - common/mctl-common/CRONITOR_MANAGEMENT_KEY
# CRONITOR_PING_KEY=op://mctl - common/mctl-common/CRONITOR_PING_KEY

# ── CAPZ ──────────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=op://mctl - common/mctl-azure/AZURE_SUBSCRIPTION_ID
AZURE_TENANT_ID=op://mctl - common/mctl-azure/AZURE_TENANT_ID
AZURE_CLIENT_ID=op://mctl - common/mctl-azure/AZURE_CLIENT_ID
AZURE_CLIENT_SECRET=op://mctl - common/mctl-azure/AZURE_CLIENT_SECRET
AZURE_LOCATION=op://mctl - common/mctl-azure/AZURE_LOCATION

# DNS operator SP — use mctl-azure-dns if separate, else same as bootstrap SP
DNS_OPERATOR_AZURE_CLIENT_ID=op://mctl - common/mctl-azure-dns/DNS_OPERATOR_AZURE_CLIENT_ID
DNS_OPERATOR_AZURE_CLIENT_SECRET=op://mctl - common/mctl-azure-dns/DNS_OPERATOR_AZURE_CLIENT_SECRET
DNS_OPERATOR_AZURE_TENANT_ID=op://mctl - common/mctl-azure-dns/DNS_OPERATOR_AZURE_TENANT_ID
DNS_OPERATOR_AZURE_SUBSCRIPTION_ID=op://mctl - common/mctl-azure-dns/DNS_OPERATOR_AZURE_SUBSCRIPTION_ID
DNS_OPERATOR_AZURE_RESOURCE_GROUP=op://mctl - common/mctl-azure-dns/DNS_OPERATOR_AZURE_RESOURCE_GROUP

# ── CAPA ──────────────────────────────────────────────────────────────────────
# Bootstrap IAM credentials — used by the AWS SDK to create IAM users,
# SNS topics, etc. Standard AWS SDK env vars; loaded via LoadDefaultConfig.
AWS_ACCESS_KEY_ID=op://mctl - common/mctl-aws/AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=op://mctl - common/mctl-aws/AWS_SECRET_ACCESS_KEY
AWS_REGION=op://mctl - common/mctl-aws/AWS_REGION

# Route53 DNS operator — pre-existing credentials written into CCR (CAPV, CAPVCD too)
ROUTE53_DNS_ACCESS_KEY_ID=op://mctl - common/mctl-route53/ROUTE53_DNS_ACCESS_KEY_ID
ROUTE53_DNS_SECRET_ACCESS_KEY=op://mctl - common/mctl-route53/ROUTE53_DNS_SECRET_ACCESS_KEY
ROUTE53_DNS_ROLE_ARN=op://mctl - common/mctl-route53/ROUTE53_DNS_ROLE_ARN

# ── CAPV ──────────────────────────────────────────────────────────────────────
VSPHERE_SERVER=op://mctl - common/mctl-vsphere/VSPHERE_SERVER
VSPHERE_USERNAME=op://mctl - common/mctl-vsphere/VSPHERE_USERNAME
VSPHERE_PASSWORD=op://mctl - common/mctl-vsphere/VSPHERE_PASSWORD
VSPHERE_DATACENTER=op://mctl - common/mctl-vsphere/VSPHERE_DATACENTER
VSPHERE_DATASTORE=op://mctl - common/mctl-vsphere/VSPHERE_DATASTORE
VSPHERE_THUMBPRINT=op://mctl - common/mctl-vsphere/VSPHERE_THUMBPRINT

# ── CAPVCD ────────────────────────────────────────────────────────────────────
VCD_REFRESH_TOKEN=op://mctl - common/mctl-vcd/VCD_REFRESH_TOKEN
